{
  "folders": [
    {
      "name": "Dotfiles",
      "path": ".",
    },
    {
      "name": "Dotfiles Work",
      "path": "../.dotfileswork",
    },
    {
      "name": "home",
      "path": "..",
    },
    {
      "name": "work/bin",
      "path": "../work/.bin",
    },
    {
      "name": "CloudDocs/shell",
      "path": "../Library/Mobile Documents/com~apple~CloudDocs/shell",
    },
  ],
  "settings": {
    "peacock.color": "#6964E6",
    // Object-valued settings are not deep-merged across scopes: this workspace
    // value replaces the user-level one wholesale, so it must be self-contained.
    // It re-states the user's entries plus the trees that live under "home".
    "files.watcherExclude": {
      "**/.cache/**": true,
      "**/.local/**": true,
      "**/.npm/**": true,
      "**/.nvm/**": true,
      "**/node_modules/**": true,
      "**/target/**": true,
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/.ammonite/**": true,
      "**/.bloop/**": true,
      "**/.metals/**": true,
      "**/.tmp/**": true,
    },

    // Nothing in a dotfiles repo is a JS/TS project; skip the task/script scans.
    "npm.autoDetect": "off",
    "task.autoDetect": "off",
    "typescript.tsc.autoDetect": "off",

    // "home" as a folder root otherwise makes the git extension hunt for repos.
    "git.autoRepositoryDetection": "openEditors",

    // $HOME contains symlinks that leave the workspace or loop.
    "search.followSymlinks": false,

    // Tailwind IntelliSense walked $HOME for 25 min at ~1400% CPU hunting for
    // configs and package.json. There is no Tailwind here; give it nothing.
    "tailwindCSS.files.exclude": [
      "**/.cache/**",
      "**/.local/**",
      "**/.npm/**",
      "**/.nvm/**",
      "**/Library/**",
      "**/node_modules/**",
      "**/.git/**",
    ],
    "files.exclude": {
      // -----------------------------------------------------------------------
      // ------------------------- DEV FILES -----------------------------------
      // -----------------------------------------------------------------------
      // config folders
      // .cache is 1,247,769 entries / 36G and .local is 407,985 entries. Leaving
      // them visible made every extension file scan walk them. Excluding them
      // here also removes them from search and from workspace.findFiles callers.
      ".cache": true,
      ".local": true,

      // Small enough to browse: .config is ~3.3K entries, .ssh is ~10.
      ".config": false,
      ".ssh": false,

      // -----------------------------------------------------------------------
      // ------------------------ DEV FOLDERS ----------------------------------
      // -----------------------------------------------------------------------
      // shell files
      ".bash_history": false,
      ".bash_profile": false,
      ".bashrc": false,
      ".profile": false,
      ".zlogin": false,
      ".zprofile": false,
      ".zsh_history": false,
      ".zshenv": false,
      ".zshrc": false,

      // shell config files
      ".gitconfig": false,
      ".gitignore_global": false,

      // dev config files
      ".eslintrc": false,
      ".npmrc": false,
      ".yarnrc": false,

      // -----------------------------------------------------------------------
      // -------------------- HIDDEN MAYBE DEV FILES ---------------------------
      // -----------------------------------------------------------------------
      // shell folders
      ".antidote": true,
      ".dotfiles": true,
      ".npm": true,
      ".nvm": true,

      // work stuff
      ".vscode*": true,
      "dev": true,
      "work": true,

      // shell config files
      ".fasd": true,
      ".z": true,
      ".zcompdump*": true,

      // dev config files
      ".gemrc": true,
      ".netrc": true,
      ".node_repl_history": true,

      // -----------------------------------------------------------------------
      // ------------------------ HIDDEN FILES ---------------------------------
      // -----------------------------------------------------------------------
      // dev folders
      ".node-gyp": true,
      ".obs": true,
      ".pnpm-state": true,
      ".swiftpm": true,

      // hidden general folders
      ".1password": true,
      ".adobe": true,
      ".bash_sessions": true,
      ".bridge": true,
      ".BZG": true,
      ".cups": true,
      ".degit": true,
      ".docker": true,
      ".dropbox": true,
      ".gnupg": true,
      ".kube": true,
      ".minikube": true,
      ".mshell": true,
      ".pyenv": true,
      ".redhat": true,
      ".sfdx": true,
      ".subversion": true,
      ".Trash": true,
      ".vnc": true,
      ".wakatime": true,
      ".waveterm": true,
      ".zsh_sessions": true,
      "_hd backups": true,
      "Applications": true,
      "Creative Cloud Files*": true,
      "Desktop": true,
      "Documents": true,
      "Downloads": true,
      "iCloud Drive*": true,
      "Library": true,
      "Movies": true,
      "Music": true,
      "Pictures": true,
      "Public": true,
      "Sites": true,

      // hidden files we don't care about
      ".*.cfg": true,
      ".*.db": true,
      ".*log": true,
      ".CFUserTextEncoding": true,
      ".DS_Store": true,
      ".httrack.ini": true,
      ".hushlogin": true,
      ".lesshst": true,
      ".rnd": true,
      ".viminfo": true,
      ".wakatime*": true,
    },
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#9390ed",
      "activityBar.background": "#9390ed",
      "activityBar.foreground": "#15202b",
      "activityBar.inactiveForeground": "#15202b99",
      "activityBarBadge.background": "#c0241f",
      "activityBarBadge.foreground": "#e7e7e7",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#9390ed",
      "statusBar.background": "#6964e6",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#9390ed",
      "statusBarItem.remoteBackground": "#ed9591",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#6964e6",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#6964e699",
      "titleBar.inactiveForeground": "#e7e7e799",
      "activityBarTop.activeBackground": "#9390ed",
      "activityBarTop.background": "#9390ed",
      "activityBarTop.foreground": "#15202b",
      "activityBarTop.inactiveForeground": "#15202b99",
      "commandCenter.foreground": "#e7e7e7",
      "statusBar.debuggingBackground": "#6964e6",
      "statusBar.debuggingForeground": "#e7e7e7"
    },
  },
}
