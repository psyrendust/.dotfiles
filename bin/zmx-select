#!/usr/bin/env zsh
#
# zmx-select
# An interactive zmx session picker that lets you fuzzy-find existing sessions,
# preview their scrollback history, or create new ones.
# See https://github.com/neurosnap/zmx#session-picker
#-------------------------------------------------------------------------------

set -e

typeset -g PROG=${0:t}

# --- picker -------------------------------------------------------------------
#
# Same fzf-outliving-us hazard as bin/zmx-prune, and kept local for the same
# reason (each script stays a standalone drop-in on PATH). fzf draws on /dev/tty
# directly, so losing our stdio does not kill it; losing the terminal's
# FOREGROUND process group stops it with SIGTTOU, and a stopped process never
# acts on a pending SIGHUP/SIGTERM, so it lingers on pid 1 holding /dev/tty.
#
# So: run fzf inside OUR process group (no_monitor keeps it out of a background
# pgroup, preserving foreground tty access), remember its pid, and reap with
# SIGCONT-then-SIGKILL so a stopped fzf actually dies.
typeset -g fzf_pid= fzf_out=

reap_fzf() {
  [[ -n $fzf_pid ]] || return 0
  kill -CONT $fzf_pid 2>/dev/null || true
  kill -KILL $fzf_pid 2>/dev/null || true
  fzf_pid=
}

# fzf_pick <input-file> [fzf-arg...]; selection lands in $fzf_out, fzf's status
# is returned. Clearing $fzf_pid after the wait matters: a later reap must never
# signal a recycled pid.
fzf_pick() {
  local src=$1; shift
  { : < /dev/tty } 2>/dev/null || { print -ru2 -- "$PROG: the picker needs a terminal"; exit 1 }
  local out
  out=$(mktemp "${TMPDIR:-/tmp}/${PROG}-fzf.XXXXXX") || { print -ru2 -- "$PROG: mktemp failed"; exit 1 }
  unsetopt monitor
  fzf "$@" < "$src" > "$out" &
  fzf_pid=$!
  local -i rc=0
  wait $fzf_pid || rc=$?
  fzf_pid=
  fzf_out=$(<"$out")
  rm -f -- "$out"
  return $rc
}

# Same age formatting as bin/zmx-prune, kept local so each script stays a
# standalone drop-in on PATH.
human_age() {
  local -i s=$1
  local -i d=$(( s / 86400 )) h=$(( s % 86400 / 3600 )) m=$(( s % 3600 / 60 ))
  if   (( d )); then print -r -- "${d}d${h}h"
  elif (( h )); then print -r -- "${h}h${m}m"
  elif (( m )); then print -r -- "${m}m"
  else              print -r -- "${s}s"
  fi
}

run() {
  local line rec name pid clients created dir
  local -a fields recs
  local -i now=$(date +%s) w_dir=8

  for line in ${(f)"$(zmx list 2>/dev/null)"}; do
    fields=("${(@s:	:)line}")
    name=${fields[1]#*name=}
    pid=${fields[2]#*pid=}
    clients=${fields[3]#*clients=}
    created=${fields[4]#*created=}
    dir=${fields[5]#*start_dir=}
    [[ -n $name ]] || continue

    dir=${dir/#$HOME/\~}
    if (( ${#dir} > w_dir )); then w_dir=${#dir}; fi
    # Sort key comes first: worktree path, then creation time (zero-padded so
    # the lexical sort stays chronological) -- grouped by worktree, oldest
    # session first. Both key fields are dropped when the row is printed.
    fields=("$dir" "${(l:12::0:)created}"
            "$(human_age $(( now - created )))" "$clients" "$pid" "$name")
    recs+=("${(pj:\t:)fields}")
  done

  # SESSION is the last column on purpose: worktree paths can contain spaces,
  # so `awk $NF` / fzf `{-1}` stay correct no matter how the path splits.
  local row_fmt="%-${w_dir}s  %-7s  %-3s  %-7s  %s"
  local header=$(printf "$row_fmt" WORKTREE AGE CLI PID SESSION)

  local display
  for rec in ${(o)recs}; do
    fields=("${(@s:	:)rec}")
    display+=$(printf "$row_fmt" "$fields[1]" "$fields[3]" "$fields[4]" \
      "$fields[5]" "$fields[6]")$'\n'
  done
  display=${display%$'\n'}

  local output query key selected session_name src
  src=$(mktemp "${TMPDIR:-/tmp}/${PROG}-rows.XXXXXX") || { print -ru2 -- "$PROG: mktemp failed"; exit 1 }
  # A plain `[[ -n … ]] && print` would return 1 on an empty list and trip `set -e`.
  if [[ -n "$display" ]]; then print -r -- "$display" > "$src"; fi
  local -i rc=0
  fzf_pick "$src" \
    --print-query \
    --expect=ctrl-n \
    --height=80% \
    --reverse \
    --prompt="zmx> " \
    --header="Enter: select | Ctrl-N: create new
$header" \
    --preview='zmx history {-1}' \
    --preview-window=right:60%:follow \
    || rc=$?
  rm -f -- "$src"
  output=$fzf_out

  query=$(echo "$output" | sed -n '1p')
  key=$(echo "$output" | sed -n '2p')
  selected=$(echo "$output" | sed -n '3p')

  if [[ "$key" == "ctrl-n" && -n "$query" ]]; then
    session_name="$query"
  elif [[ $rc -eq 0 && -n "$selected" ]]; then
    session_name=$(echo "$selected" | awk '{print $NF}')
  elif [[ -n "$query" ]]; then
    session_name="$query"
  else
    return 130
  fi

  zmx attach "$session_name"
}

trap 'reap_fzf' EXIT
trap 'reap_fzf; exit 130' INT HUP TERM

run && exit
