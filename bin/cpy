#!/usr/bin/env zsh
#
# cpy
# Copy the current directory, a file/directory path, or piped stdin to the
# clipboard without a trailing newline.
#
# By default, copies the path relative to the git repository root (./...) when
# inside a subdirectory or targeting a file in a git worktree, and falls back
# to the home-shortened path (~/...) at the git root itself or outside git.
#
# Usage: cpy [-s|--short] [-a|--abs] [-p|--pick] [-I|--ignored] [-h|--help] [path]
#   -s, --short    Copy full path using ~/ shorthand (ignores git root).
#   -a, --abs      Copy full path with /Users/<user> expanded.
#   -p, --pick     Interactively pick one or more files/directories (Tab to multi-select).
#   -I, --ignored  Include gitignored files when picking with -p/--pick.
#   -h, --help     Show this help and exit.
#-------------------------------------------------------------------------------

emulate -L zsh
setopt err_exit no_unset pipe_fail

typeset -g PROG=${0:t}

die() {
  print -ru2 -- "$PROG: $*"
  exit 1
}

usage() {
  cat <<'EOF'
cpy — copy a directory/file path (or piped stdin) to the clipboard without a trailing newline.

By default, copies a ./path relative to the git repository root when inside a
git worktree (or a ~/path when at the git root itself or outside a git repo).
When stdin is piped and no arguments or flags are given, copies stdin with the
trailing newline stripped.

Usage: cpy [-s|--short] [-a|--abs] [-p|--pick] [-I|--ignored] [-h|--help] [path]
  -s, --short    Copy full path using ~/ shorthand (ignores git root).
  -a, --abs      Copy full path with /Users/<user> expanded.
  -p, --pick     Interactively pick one or more files/directories (Tab to multi-select).
  -I, --ignored  Include gitignored files when picking with -p/--pick.
  -h, --help     Show this help and exit.
EOF
}

# --- picker -------------------------------------------------------------------
#
# Same fzf-outliving-us guard as bin/zmx-select: run fzf inside our process
# group (unsetopt monitor) and reap with SIGCONT-then-SIGKILL on exit so a
# stopped fzf never lingers on /dev/tty.
typeset -g fzf_pid= fzf_out=
typeset -ga picked_paths=()

reap_fzf() {
  [[ -n $fzf_pid ]] || return 0
  kill -CONT $fzf_pid 2>/dev/null || true
  kill -KILL $fzf_pid 2>/dev/null || true
  fzf_pid=
}

fzf_pick() {
  local src=$1; shift
  (( $+commands[fzf] )) || die "fzf not found"
  local out
  out=$(mktemp "${TMPDIR:-/tmp}/${PROG}-fzf.XXXXXX") || die "mktemp failed"
  unsetopt monitor
  fzf "$@" < "$src" > "$out" &
  fzf_pid=$!
  local -i rc=0
  wait $fzf_pid || rc=$?
  fzf_pid=
  fzf_out=$(<"$out")
  rm -f -- "$out"
  return $rc
}

list_candidates() {
  local search_dir=$1 include_ignored=$2
  if (( $+commands[fd] )); then
    local -a fd_flags=(--hidden --follow --exclude .git --base-directory "$search_dir")
    (( include_ignored )) && fd_flags+=(--no-ignore)
    fd "${fd_flags[@]}" 2>/dev/null | sed 's#/$##'
  elif (( $+commands[bfs] )); then
    bfs -H "$search_dir" -exclude -name .git -mindepth 1 -printf '%P\n' 2>/dev/null
  else
    (
      cd -- "$search_dir" &&
      find -L . -name .git -prune -o -mindepth 1 -print 2>/dev/null | sed 's#^\./##'
    )
  fi
}

pick_paths() {
  local base_dir=${1:-.} include_ignored=${2:-0}
  [[ -e $base_dir || -L $base_dir ]] || die "$base_dir: no such file or directory"
  [[ -d $base_dir ]] || die "$base_dir: not a directory"

  local src
  src=$(mktemp "${TMPDIR:-/tmp}/${PROG}-rows.XXXXXX") || die "mktemp failed"
  list_candidates "$base_dir" "$include_ignored" > "$src" || true

  local preview_cmd
  preview_cmd="p=${(qq)base_dir}/\${1}; if [[ -d \$p ]]; then if command -v eza >/dev/null 2>&1; then eza --tree --level=2 --color=always -- \"\$p\" | head -200; elif command -v tree >/dev/null 2>&1; then tree -C -L 2 -- \"\$p\" | head -200; else ls -la -- \"\$p\"; fi; elif command -v bat >/dev/null 2>&1; then bat --color=always --style=numbers --line-range=:200 -- \"\$p\"; else head -n 200 -- \"\$p\"; fi"

  local -i rc=0
  fzf_pick "$src" \
    -m \
    --height=80% \
    --reverse \
    --prompt="cpy> " \
    --header="Enter: copy | Tab: multi-select" \
    --preview="zsh -c ${(qq)preview_cmd} -- {}" \
    || rc=$?
  rm -f -- "$src"

  if (( rc != 0 )) || [[ -z $fzf_out ]]; then
    return 130
  fi

  local item
  picked_paths=()
  for item in "${(@f)fzf_out}"; do
    [[ -n $item ]] || continue
    if [[ $base_dir == "." ]]; then
      picked_paths+=("$item")
    else
      picked_paths+=("${base_dir%/}/$item")
    fi
  done
}

format_path() {
  local target=$1 use_short=$2 use_abs=$3
  [[ -e $target || -L $target ]] || die "$target: no such file or directory"

  local target_abs=${target:a}
  if (( use_abs )); then
    REPLY=$target_abs
    return 0
  elif (( use_short )); then
    REPLY=${target_abs/#$HOME/\~}
    return 0
  fi

  local probe_dir
  if [[ -d $target && ! -L $target ]]; then
    probe_dir=$target_abs
  else
    probe_dir=${target_abs:h}
  fi

  local git_root=""
  if git_root=$(git -C "$probe_dir" rev-parse --show-toplevel 2>/dev/null) && [[ -n $git_root ]]; then
    if [[ $target_abs == "$git_root" ]]; then
      REPLY=${target_abs/#$HOME/\~}
    elif [[ $target_abs == "$git_root/"* ]]; then
      REPLY="./${target_abs#$git_root/}"
    else
      # Fallback when $PWD traverses a symlink and git_root is physical (:A).
      local target_phys=${target:A}
      local root_phys=${git_root:A}
      if [[ $target_phys == "$root_phys/"* ]]; then
        REPLY="./${target_phys#$root_phys/}"
      else
        REPLY=${target_abs/#$HOME/\~}
      fi
    fi
  else
    REPLY=${target_abs/#$HOME/\~}
  fi
}

trap 'reap_fzf' EXIT
trap 'reap_fzf; exit 130' INT HUP TERM

# --- main ---------------------------------------------------------------------

main() {
  local -a opt_short opt_abs opt_pick opt_ignored opt_help
  zparseopts -D -E -F -- \
    s=opt_short   -short=opt_short     \
    a=opt_abs     -abs=opt_abs         \
    p=opt_pick    -pick=opt_pick       \
    I=opt_ignored -ignored=opt_ignored \
    h=opt_help    -help=opt_help       \
    || exit 1

  if (( ${#opt_help} )); then
    usage
    exit 0
  fi

  if (( $# > 1 )); then
    die "too many arguments (expected at most 1 path)"
  fi

  # When stdin is piped and no path/flags were passed (`cmd | cpy`), copy stdin
  # with trailing newlines stripped.
  if [[ -p /dev/stdin ]] && (( $# == 0 && ! ${#opt_pick} && ! ${#opt_short} && ! ${#opt_abs} && ! ${#opt_ignored} )); then
    local piped
    piped=$(cat)
    printf '%s' "$piped" | pbcopy
    print -r -- "$piped"
    return 0
  fi

  local -i use_short=$(( ${#opt_short} > 0 ))
  local -i use_abs=$(( ${#opt_abs} > 0 ))
  local -i include_ignored=$(( ${#opt_ignored} > 0 ))

  local -a targets=()
  if (( ${#opt_pick} )); then
    pick_paths "${1:-.}" "$include_ignored" || exit $?
    targets=("${picked_paths[@]}")
  else
    targets=("${1:-$PWD}")
  fi

  local -a formatted=()
  local t REPLY=
  for t in "${targets[@]}"; do
    format_path "$t" "$use_short" "$use_abs"
    formatted+=("$REPLY")
  done

  local out=${(pj:\n:)formatted}
  printf '%s' "$out" | pbcopy
  print -r -- "$out"
}

main "$@"
