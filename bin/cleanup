#!/usr/bin/env zsh
#
# cleanup
# List the live worktrees, the local branches no worktree is using, all closed
# PRs whose branches still exist locally, and any orphaned worktree
# directories/VSCode workspace files left behind by an earlier removal.
# Fuzzy select items for deletion. Selecting a live worktree removes the worktree
# and its VSCode workspace file; the branch goes too when it holds no unique
# commits, which is the `wtree` + `git merge --ff-only` flow where no PR exists.
# Every row's label says what selecting it costs, so snapshot branches an agent
# left behind are told apart from work that only exists locally.
#-------------------------------------------------------------------------------

set -e

# Parse command line arguments
DRY_RUN=false
NO_COLOR=false
INCLUDE_WORKTREES=true
INCLUDE_BRANCHES=true
while [[ $# -gt 0 ]]; do
  case $1 in
    -d|--dry-run)
      DRY_RUN=true
      shift
      ;;
    -n|--no-color)
      NO_COLOR=true
      shift
      ;;
    -w|--worktrees)
      # Live worktrees are listed by default; accepted so old invocations work.
      INCLUDE_WORKTREES=true
      shift
      ;;
    -W|--no-worktrees)
      INCLUDE_WORKTREES=false
      shift
      ;;
    -B|--no-branches)
      INCLUDE_BRANCHES=false
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: cleanup [-d|--dry-run] [-n|--no-color] [-W|--no-worktrees] [-B|--no-branches]"
      exit 1
      ;;
  esac
done

# ANSI color codes (will be empty if NO_COLOR is true)
if [[ "$NO_COLOR" == true ]]; then
  GREY=''
  MAGENTA=''
  WHITE=''
  CYAN=''
  BLUE=''
  GREEN=''
  RED=''
  YELLOW=''
  RESET=''
else
  GREY='\033[90m'
  MAGENTA='\033[35m'
  WHITE='\033[97m'
  CYAN='\033[36m'
  BLUE='\033[34m'
  GREEN='\033[32m'
  RED='\033[31m'
  YELLOW='\033[33m'
  RESET='\033[0m'
fi

logStep() {
  printf "${CYAN}[cleanup] ${WHITE}${1}: ${GREY}${2}${RESET}\n"
}

logEmpty() {
  printf "${BLUE}[cleanup] ${WHITE}${1}${RESET}\n"
}

logDryRun() {
  if [[ "$DRY_RUN" == true ]]; then
    printf "${MAGENTA}[dry-run] ${WHITE}${1}: ${GREY}${2}${RESET}\n"
  fi
}

# Drop the ANSI color codes from stdin. Row keys and the selection both go
# through this, so a row always maps back onto the key it was stored under.
stripAnsi() {
  sed 's/\x1b\[[0-9;]*m//g'
}

trashWorkspaceFile() {
  local file="$1"
  if [[ -n "$file" ]] && [[ -a "$file" ]]; then
    if [[ "$DRY_RUN" == true ]]; then
      logDryRun "Deleted VSCode workspace file" "$file"
    else
      trash "$file"
      logStep "Deleted VSCode workspace file" "$file"
    fi
  fi
}

# Remove a registered worktree, then trash its <dir>.code-workspace file. Falls
# back to trashing the directory when `git worktree remove` refuses (dirty or
# locked worktree) so the files stay recoverable from the Trash.
removeWorktree() {
  # NB: not named `path` — in zsh that variable is tied to $PATH.
  local worktree="$1"
  local removeError=""
  [[ -n "$worktree" ]] && [[ -d "$worktree" ]] || return 0
  if [[ "$DRY_RUN" == true ]]; then
    logDryRun "Removed worktree" "$worktree"
  elif removeError=$(git worktree remove "$worktree" 2>&1); then
    logStep "Removed worktree" "$worktree"
  else
    printf "${RED}[cleanup] git worktree remove failed: ${GREY}${removeError}${RESET}\n" >&2
    trash "$worktree"
    git worktree prune -v
    logStep "Trashed worktree" "$worktree"
  fi
  trashWorkspaceFile "${worktree}.code-workspace"
}

# Paths of registrations whose directory no longer exists, one per line. Such a
# registration still owns its branch, so it has to go before the branch can.
staleWorktrees() {
  local wt=""
  git worktree list --porcelain | awk '/^worktree / { print substr($0, 10) }' |
    while IFS= read -r wt; do
      if [[ -n "$wt" ]] && [[ ! -d "$wt" ]]; then
        print -r -- "$wt"
      fi
    done
}

# Forget those registrations. `git worktree prune` alone is not enough: it skips a
# locked worktree, and Supacode locks the ones it creates, so the entry survives
# with its directory long gone. Unlocking first is safe here because the working
# copy the lock protects is already missing.
pruneStaleWorktrees() {
  local wt=""
  while IFS= read -r wt; do
    [[ -z "$wt" ]] && continue
    git worktree unlock "$wt" >/dev/null 2>&1 || true
  done <<< "$(staleWorktrees)"
  git worktree prune
}

# Delete a local branch. Used after its worktree is gone, so the branch is no
# longer checked out anywhere. Silent when the branch is already gone, so a
# worktree removal that took the branch with it is not an error.
deleteBranch() {
  local branch="$1" deleteError=""
  [[ -n "$branch" ]] || return 0
  if [[ "$DRY_RUN" == true ]]; then
    logDryRun "Deleted branch" "$branch"
  elif git show-ref --verify --quiet "refs/heads/${branch}"; then
    if ! deleteError=$(git branch -D "$branch" 2>&1); then
      # A registration pointing at a directory that no longer exists still counts
      # as "used by worktree", which is how a trashed worktree leaves its branch
      # undeletable. Forget those registrations, then retry.
      pruneStaleWorktrees
      if ! deleteError=$(git branch -D "$branch" 2>&1); then
        printf "${RED}[cleanup] git branch -D failed: ${GREY}${deleteError}${RESET}\n" >&2
        return 0
      fi
    fi
    logStep "Deleted branch" "$branch"
  fi
}

# Rows generated below are matched back to their action through this map, keyed
# on the row's uncolored text. A path can hold spaces, so it cannot be recovered
# by splitting a rendered row; keys are exact, values are
# "<type>\t<path>\t<branch>" with an empty branch field when nothing is reaped.
typeset -A ROW_ACTION

# Remember what selecting a formatted row should do.
#   $1 type (orphaned-workspace|orphaned-dir|live-worktree)
#   $2 path the action operates on
#   $3 the formatted (colored) row
#   $4 branch to delete along with the path, empty to keep the branch
registerRow() {
  local rowType="$1" target="$2" row="$3" branch="${4:-}"
  local key=$(echo "$row" | stripAnsi)
  ROW_ACTION[$key]="${rowType}"$'\t'"${target}"$'\t'"${branch}"
}

# Create a temporary file for local branches
TEMP_BRANCHES=$(mktemp)
trap 'trash "$TEMP_BRANCHES"' EXIT

# Get list of local branches
git for-each-ref --format='%(refname:short)' refs/heads > "$TEMP_BRANCHES"

# Quoted: a worktree path can contain spaces, and an unquoted expansion here
# hands `dirname` two arguments.
GIT_ROOT="$(git-root)"
WORKTREE_ROOT="$(dirname "$GIT_ROOT")"
# Registrations whose directory is already gone are dropped here: they cannot be
# removed as worktrees, and while one is listed it hides its own branch from the
# local-branch rows below, which is the only place that branch can be reaped from.
STALE_WORKTREES=$(staleWorktrees)
if [[ -n "$STALE_WORKTREES" ]]; then
  while IFS= read -r stale_worktree; do
    [[ -z "$stale_worktree" ]] && continue
    if [[ "$DRY_RUN" == true ]]; then
      logDryRun "Pruned stale worktree registration" "$stale_worktree"
    else
      logStep "Pruned stale worktree registration" "$stale_worktree"
    fi
  done <<< "$STALE_WORKTREES"
  [[ "$DRY_RUN" == true ]] || pruneStaleWorktrees
fi
# Real runs have pruned them by now; a dry run has not, so drop them by hand and
# both modes list the same rows.
# The list goes through the environment: `awk -v` rejects a value holding a
# newline, and a worktree path per line is exactly that.
WORKTREE_LIST=$(git worktree list --porcelain | STALE_WORKTREES="$STALE_WORKTREES" awk '
  BEGIN {
    RS = ""; ORS = "\n\n"
    n = split(ENVIRON["STALE_WORKTREES"], paths, "\n")
    for (i = 1; i <= n; i++) {
      if (paths[i] != "") gone["worktree " paths[i]] = 1
    }
  }
  {
    first = $0
    sub(/\n.*/, "", first)
    if (!(first in gone)) print
  }
')

# Get the header (always needed for display)
PR_OUTPUT=$(git-prclosed)
HEADER=$(echo "$PR_OUTPUT" | head -n 2)

# Extract column widths from the separator line (line 2: dashes separated by spaces)
# This gives us: BRANCH_W, CLOSED_AT_W, ID_W, TITLE_W, URL_W
COL_WIDTHS=($(echo "$HEADER" | tail -n 1 | stripAnsi | awk '{
  for (i = 1; i <= NF; i++) print length($i)
}'))
BRANCH_W=${COL_WIDTHS[1]}
CLOSED_AT_W=${COL_WIDTHS[2]}

# Width of the status column on the non-PR rows. The PR rows put a relative date
# there, which is usually narrower than the longest label ("live worktree
# (unpushed)"), so widen it to keep those rows' path column aligned.
LABEL_W=$CLOSED_AT_W
(( LABEL_W < 24 )) && LABEL_W=24

# The PR rows arrive pre-rendered at BRANCH_W. The rows this script renders pad to
# the longest name they actually hold instead, since an agent's branch names run
# well past that width and would push every label and path out of column.
WORKSPACE_FILES=("$WORKTREE_ROOT"/*.code-workspace(N))
ROW_BRANCH_W=$BRANCH_W
# A branch name is measured whole: `backup/pre-squash` is what the row shows, so
# taking its tail here would leave the row a path separator too wide.
for row_name in ${(f)"$(cat "$TEMP_BRANCHES")"}; do
  (( ${#row_name} > ROW_BRANCH_W )) && ROW_BRANCH_W=${#row_name}
done
# Worktrees and workspace files show up under their directory name.
for row_path in \
  ${(f)"$(echo "$WORKTREE_LIST" | awk '/^worktree / { print substr($0, 10) }')"} \
  $WORKSPACE_FILES; do
  row_name="${${row_path%.code-workspace}:t}"
  (( ${#row_name} > ROW_BRANCH_W )) && ROW_BRANCH_W=${#row_name}
done

# Get closed PR info and filter to only show branches that exist locally
FILTERED_OUTPUT=$(echo "$PR_OUTPUT" | awk -v branches_file="$TEMP_BRANCHES" '
  BEGIN {
    # Read local branches into an array
    while ((getline branch < branches_file) > 0) {
      local[branch] = 1
    }
    close(branches_file)
  }
  NR <= 2 {
    # Print header and separator lines
    print
    next
  }
  {
    # Extract branch name (1st column in new format: BRANCH, CLOSED AT, ID, TITLE)
    line = $0

    # Strip ANSI color codes
    gsub(/\033\[[0-9;]*m/, "", line)

    # Branch is now the first column
    match(line, /^[^ ]+/)  # BRANCH column
    branch = substr(line, RSTART, RLENGTH)

    # Only print if branch exists locally
    if (branch in local) {
      print
    }
  }
')

# Find orphaned worktrees by scanning for <dir>.code-workspace files (created by
# wtree) whose <dir> is no longer a registered git worktree. This is independent
# of PR status, so it also catches a worktree removed by hand with
# `git worktree remove` (which leaves the workspace file behind) and worktrees
# merged locally with `git merge --ff-only` (no PR involved at all).
ORPHANED_LINES=""
for workspace_file in $WORKSPACE_FILES; do
  dir="${workspace_file%.code-workspace}"
  [[ "$dir" == "$GIT_ROOT" ]] && continue
  echo "$WORKTREE_LIST" | grep -qxF -- "worktree ${dir}" && continue
  if [[ -d "$dir" ]]; then
    row_type="orphaned-dir"
    label="orphaned dir"
    orphan_path="$dir"
  else
    row_type="orphaned-workspace"
    label="orphaned workspace"
    orphan_path="$workspace_file"
  fi
  row=$(printf "${CYAN}%-${ROW_BRANCH_W}s${RESET}  ${YELLOW}%-${LABEL_W}s${RESET}  ${GREY}%s${RESET}" "${dir:t}" "$label" "$orphan_path")
  registerRow "$row_type" "$orphan_path" "$row"
  ORPHANED_LINES+="${row}\n"
done

CLOSED_PR_BRANCHES=$(echo "$FILTERED_OUTPUT" | tail -n +3 | stripAnsi | awk '{ print $1 }')
MAIN_WORKTREE=$(echo "$WORKTREE_LIST" | awk '/^worktree / { print substr($0, 10); exit }')
DEFAULT_BRANCH=$(git-default-branch 2>/dev/null || echo "")

# Both refs are checked: after a local `--ff-only` merge the commits are in the
# local default branch and origin's copy is still behind.
DEFAULT_BASES=()
if [[ -n "$DEFAULT_BRANCH" ]]; then
  if git rev-parse --verify --quiet "refs/heads/${DEFAULT_BRANCH}" >/dev/null; then
    DEFAULT_BASES+=("$DEFAULT_BRANCH")
  fi
  if git rev-parse --verify --quiet "refs/remotes/origin/${DEFAULT_BRANCH}" >/dev/null; then
    DEFAULT_BASES+=("origin/${DEFAULT_BRANCH}")
  fi
fi

# How much unique work a ref holds, so a row's label can say what deleting it
# costs. Echoes exactly one of:
#   merged   every commit is already in the default branch (or origin's copy)
#   rebased  every commit has a patch-identical twin there, so the ref is a
#            snapshot of work that landed under rewritten SHAs
#   pushed   the default branch lacks the commits, but the ref's upstream has
#            all of them, so deleting is recoverable from origin
#   unique   commits live only here
# Fails closed: a ref nothing can be read from counts as unique.
classifyRef() {
  local ref="$1" base="" cherry=""
  for base in "${DEFAULT_BASES[@]}"; do
    if [[ "$(git rev-list --count "${base}..${ref}" 2>/dev/null || echo 1)" == 0 ]]; then
      echo merged
      return
    fi
  done
  # `git cherry` marks a commit `-` when the base already holds an equivalent
  # patch. That is what recognises a pre-rebase or pre-squash snapshot: its
  # commits are absent from the default branch by SHA but present by content.
  for base in "${DEFAULT_BASES[@]}"; do
    cherry=$(git cherry "$base" "$ref" 2>/dev/null) || continue
    if [[ -n "$cherry" ]] && ! grep -q '^+' <<< "$cherry"; then
      echo rebased
      return
    fi
  done
  if git rev-parse --verify --quiet "${ref}@{upstream}" >/dev/null 2>&1 &&
    [[ "$(git rev-list --count "${ref}@{upstream}..${ref}" 2>/dev/null || echo 1)" == 0 ]]; then
    echo pushed
    return
  fi
  echo unique
}

# Number of commits on the ref that the default branch has no equivalent of.
# Empty when there is no default branch to compare against.
uniqueCommitCount() {
  local ref="$1"
  (( ${#DEFAULT_BASES} )) || return 0
  git cherry "${DEFAULT_BASES[1]}" "$ref" 2>/dev/null | grep -c '^+' || true
}

# List the live (registered) worktrees, so one can be retired together with its
# <dir>.code-workspace file. The main worktree and the worktree we're standing in
# are skipped: neither can be removed from here. A worktree whose branch is
# already in the closed-PR list is skipped too, since selecting that row removes
# worktree, workspace file and branch in one pass.
#
# The label says what selecting the row costs. A branch is deleted along with its
# worktree only when it holds nothing unique: the commits are already in the
# default branch by SHA or by patch, or in the branch's own upstream. That is what
# catches both the `wtree` + `git merge --ff-only` flow, where no PR ever existed
# and only the local default branch has the commits, and the rebase-then-merge
# flow, where the landed commits carry different SHAs. Anything else keeps the
# branch, because a worktree is cheap to recreate and unique work is not.
WORKTREE_LINES=""
if [[ "$INCLUDE_WORKTREES" == true ]]; then
  WORKTREE_PAIRS=$(echo "$WORKTREE_LIST" | awk '
    /^worktree / {
      if (path != "") print path "\t" branch
      path = substr($0, 10)
      branch = ""
      next
    }
    /^branch refs\/heads\// { branch = substr($0, 19) }
    END { if (path != "") print path "\t" branch }
  ')
  while IFS=$'\t' read -r wt_path wt_branch; do
    [[ -z "$wt_path" ]] && continue
    [[ "$wt_path" == "$MAIN_WORKTREE" ]] && continue
    [[ "$wt_path" == "$GIT_ROOT" ]] && continue
    [[ -n "$wt_branch" ]] && echo "$CLOSED_PR_BRANCHES" | grep -qxF -- "$wt_branch" && continue
    label="live worktree"
    label_color="$YELLOW"
    # Branch to delete with the worktree. Empty keeps the branch.
    reap_branch=""
    if [[ -n "$(git -C "$wt_path" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
      # Uncommitted tracked changes: `git worktree remove` will refuse this one.
      label="live worktree (dirty)"
      label_color="$RED"
    elif [[ -z "$wt_branch" ]]; then
      # Detached HEAD: there is no branch to reap or to reason about.
      label="live worktree (detached)"
    else
      case "$(classifyRef "$wt_branch")" in
        merged)
          label="live worktree (merged)"
          reap_branch="$wt_branch"
          ;;
        rebased)
          label="live worktree (rebased)"
          reap_branch="$wt_branch"
          ;;
        pushed)
          label="live worktree (pushed)"
          reap_branch="$wt_branch"
          ;;
        *)
          label="live worktree (unpushed)"
          label_color="$RED"
          ;;
      esac
    fi
    row=$(printf "${CYAN}%-${ROW_BRANCH_W}s${RESET}  ${label_color}%-${LABEL_W}s${RESET}  ${GREY}%s${RESET}" "${wt_branch:-${wt_path:t}}" "$label" "$wt_path")
    registerRow "live-worktree" "$wt_path" "$row" "$reap_branch"
    WORKTREE_LINES+="${row}\n"
  done <<< "$WORKTREE_PAIRS"
fi

# List the local branches no worktree is using. Nothing else in this script can
# see them: they have no closed PR, no worktree and no workspace file, so an
# agent's `-final`/`-prerebase`/`backup/*` snapshots linger forever once their
# worktree is gone. They are listed whatever they hold, and the label carries the
# risk instead of hiding the row, since only the branch itself is at stake here.
BRANCH_LINES_LOCAL=""
if [[ "$INCLUDE_BRANCHES" == true ]]; then
  WORKTREE_BRANCHES=$(echo "$WORKTREE_LIST" | awk '/^branch refs\/heads\// { print substr($0, 19) }')
  while IFS= read -r branch; do
    [[ -z "$branch" ]] && continue
    [[ "$branch" == "$DEFAULT_BRANCH" ]] && continue
    echo "$WORKTREE_BRANCHES" | grep -qxF -- "$branch" && continue
    echo "$CLOSED_PR_BRANCHES" | grep -qxF -- "$branch" && continue
    label_color="$RED"
    case "$(classifyRef "$branch")" in
      merged)
        label="branch (merged)"
        label_color="$GREEN"
        ;;
      rebased)
        label="branch (rebased)"
        label_color="$GREEN"
        ;;
      pushed)
        label="branch (pushed)"
        label_color="$YELLOW"
        ;;
      *)
        unique_count=$(uniqueCommitCount "$branch")
        label="branch (${unique_count:-?} unique)"
        ;;
    esac
    # Tip identity, so an agent snapshot can be recognised without leaving fzf.
    branch_tip=$(git log -1 --format='%h  %<(12,trunc)%cr  %s' "$branch" 2>/dev/null || echo "")
    row=$(printf "${CYAN}%-${ROW_BRANCH_W}s${RESET}  ${label_color}%-${LABEL_W}s${RESET}  ${GREY}%s${RESET}" "$branch" "$label" "$branch_tip")
    registerRow "local-branch" "$branch" "$row" "$branch"
    BRANCH_LINES_LOCAL+="${row}\n"
  done < "$TEMP_BRANCHES"
fi

# Build combined fzf input — always include header for column alignment
HAS_ITEMS=false
FZF_INPUT="$HEADER"

# Append branch lines (skip first 2 header lines from FILTERED_OUTPUT)
BRANCH_LINES=$(echo "$FILTERED_OUTPUT" | tail -n +3)
if [[ -n "$BRANCH_LINES" ]] && echo "$BRANCH_LINES" | grep -q .; then
  HAS_ITEMS=true
  FZF_INPUT="${FZF_INPUT}\n${BRANCH_LINES}"
fi

# Both blocks end in a literal "\n", stripped here so the rows stay contiguous:
# a blank row in fzf is selectable and means nothing.
if [[ -n "$ORPHANED_LINES" ]]; then
  HAS_ITEMS=true
  FZF_INPUT="${FZF_INPUT}\n${ORPHANED_LINES%\\n}"
fi

if [[ -n "$WORKTREE_LINES" ]]; then
  HAS_ITEMS=true
  FZF_INPUT="${FZF_INPUT}\n${WORKTREE_LINES%\\n}"
fi

if [[ -n "$BRANCH_LINES_LOCAL" ]]; then
  HAS_ITEMS=true
  FZF_INPUT="${FZF_INPUT}\n${BRANCH_LINES_LOCAL%\\n}"
fi

if [[ "$HAS_ITEMS" == false ]]; then
  scope="no local branches with closed PRs, no orphaned worktrees/workspace files"
  [[ "$INCLUDE_WORKTREES" == true ]] && scope="${scope}, no removable worktrees"
  [[ "$INCLUDE_BRANCHES" == true ]] && scope="${scope}, no unused local branches"
  logEmpty "Nothing to clean up: ${scope}"
  exit 0
fi

SELECTED=$(echo -n "$FZF_INPUT" | fzf -m --reverse --ansi --header-lines=2 --header="Select items to clean up")

if [[ -z "$SELECTED" ]]; then
  exit 0
fi

# Process each selected line
while IFS= read -r line; do
  # Strip ANSI codes for parsing
  clean_line=$(echo "$line" | stripAnsi)
  [[ -z "$clean_line" ]] && continue

  action="${ROW_ACTION[$clean_line]:-}"
  if [[ -n "$action" ]]; then
    # A row this script generated: type, path and branch come from the map, never
    # from splitting the row, so paths containing spaces survive.
    action_fields=("${(@ps:\t:)action}")
    row_type="${action_fields[1]}"
    target="${action_fields[2]}"
    reap_branch="${action_fields[3]:-}"
    case "$row_type" in
      orphaned-workspace)
        trashWorkspaceFile "$target"
        ;;
      orphaned-dir)
        if [[ "$DRY_RUN" == true ]]; then
          logDryRun "Trashed orphaned directory" "$target"
        else
          trash "$target"
          logStep "Trashed orphaned directory" "$target"
        fi
        trashWorkspaceFile "${target}.code-workspace"
        ;;
      live-worktree)
        # The worktree and its workspace file always go. The branch goes only
        # when the listing found nothing unique on it.
        removeWorktree "$target"
        deleteBranch "$reap_branch"
        ;;
      local-branch)
        # No worktree and no workspace directory: only the ref is at stake. Any
        # workspace file left over from an earlier worktree of the same name goes
        # too, so the pair does not reappear as an orphan on the next run.
        deleteBranch "$reap_branch"
        trashWorkspaceFile "$WORKTREE_ROOT/${target//[\\\/]/-}.code-workspace"
        ;;
    esac
  else
    # Branch line - extract branch name (1st column)
    branch=$(echo "$clean_line" | awk '{ match($0, /^[^ ]+/); print substr($0, RSTART, RLENGTH) }')
    cleanBranchName="${branch//[\\\/]/-}"

    logDryRun "Checking branch" "$branch"

    # Check if the branch is connected with a worktree
    WORKTREE_PATH=$(echo "$WORKTREE_LIST" | awk -v branch="$branch" '
      /^worktree / { path = substr($0, 10) }
      /^branch / {
        if (substr($0, 8) == "refs/heads/" branch) {
          print path
          exit
        }
      }
    ')

    # If worktree exists, remove it first
    if [[ -n "$WORKTREE_PATH" ]] && [[ -d "$WORKTREE_PATH" ]]; then
      removeWorktree "$WORKTREE_PATH"
    else
      trashWorkspaceFile "$WORKTREE_ROOT/${cleanBranchName}.code-workspace"
    fi

    deleteBranch "$branch"
  fi
done <<< "$SELECTED"
